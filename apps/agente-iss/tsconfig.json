{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["node"],
    "paths": { "@cobranca/shared": ["../../packages/shared/src/index.ts"] }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "build.mjs"]
}
