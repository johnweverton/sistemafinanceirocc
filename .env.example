# Frontend (público — exposto ao browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Backend (server-side apenas — nunca commitar valores reais; PRD §9)
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# INTEGRAÇÃO COM A API DA CARMEM (contrato PRD §6.4)
# ---------------------------------------------------------------------------
# Para LIGAR a API real quando ela existir (zero mudança de código esperada):
#   1. PROCEDIMENTOS_SOURCE=http
#   2. preencher CARMEM_API_URL (base, ex.: https://sistema-da-carmem.com.br)
#   3. preencher CARMEM_API_KEY (enviada no header X-API-Key)
# Pré-requisito de negócio (PRD §11, NÃO resolvido aqui): o programador da Carmem
# precisa confirmar qual campo é o CPF do médico responsável (assumimos `cpf_medico`)
# e se `data_emissao` é o campo usado para filtrar a competência. O client já parseia
# todos os campos do contrato e trata 401 / array vazio / retry — só falta a API no ar.
CARMEM_API_URL=
CARMEM_API_KEY=

# Modo do Integration Client: 'local' usa fixtures, 'http' chama a API real da Carmem.
PROCEDIMENTOS_SOURCE=local

# Segredo para a função se auto-invocar entre lotes (Fase 2)
INTERNAL_SECRET=

# Base URL da própria app, usada pela função para se auto-invocar entre lotes (Fase 2).
# Local: http://localhost:3000. Em Vercel, derivado de VERCEL_URL se ausente.
APP_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# GATEWAY DE BOLETOS — Fase 3 (Cora mTLS)
# ---------------------------------------------------------------------------
# GATE 1 — DECISÃO DE NEGÓCIO (feature flag):
# Emissão de boletos fica DESLIGADA por padrão. Mesmo que a API e os certificados
# estejam prontos, nenhum boleto será emitido até alguém ligar esta flag.
# PRD §10 exige validação em produção (conferência manual vs. sistema) antes de habilitar.
GATEWAY_EMISSAO_HABILITADA=false

# Qual gateway de boleto usar: 'cora' (API real com mTLS) ou 'mock' (testes/dev).
BOLETO_GATEWAY=mock

# GATE 2 — CERTIFICADO MTLS DA CORA (pendência externa):
# Para usar gateway=cora, é necessário solicitar à Cora os certificados mTLS.
# Armazene o certificado (.pem) e a chave privada (.key) como base64 nestas variáveis.
# Para converter: cat cert.pem | base64 -w0 > cert_b64.txt
CORA_CERT_BASE64=
CORA_KEY_BASE64=

# URL base da API Banking da Cora (ambiente sandbox ou produção).
# Sandbox: https://matls-clients.api.stage.cora.com.br
# Produção: https://matls-clients.api.cora.com.br
CORA_API_URL=

# Client ID da aplicação OAuth2 registrada na Cora.
CORA_CLIENT_ID=
